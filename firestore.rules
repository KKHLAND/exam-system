rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 원묵고 정기고사 관리 시스템: 관리자 판별 ──
    // 기본 관리자: 관리자 구성원 추가·삭제 가능 (src/shared/auth.ts의 DEFAULT_ADMINS와 같게 유지)
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['kkhland@gmail.com'];
    }

    // 관리자: 기본 관리자 또는 exam_admins/{구글 이메일(소문자)} 문서가 있는 계정
    function isExamAdmin() {
      return isSuperAdmin()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/exam_admins/$(request.auth.token.email.lower())));
    }

    // 관리자 구성원 목록: 기본 관리자는 앱의 '관리자 구성원' 메뉴에서 조회·추가·삭제,
    // 그 외 계정은 본인 문서 존재 여부만 확인 가능
    match /exam_admins/{email} {
      allow read: if isSuperAdmin()
        || (request.auth != null && request.auth.token.email.lower() == email);
      allow create, update: if isSuperAdmin()
        && email == email.lower()
        && email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.keys().hasOnly(['name', 'addedBy', 'addedAt']);
      allow delete: if isSuperAdmin();
    }

    // [기존 앱] 시험지 및 배치표 데이터 컬렉션 — 변경 없음
    // (통합 앱은 더 이상 사용하지 않음. 다른 앱이 쓰지 않는 것이 확인되면 isExamAdmin()으로 잠그세요)
    match /exams/{document} {
      allow read, write: if true;
    }

    // [기존 앱] 로고 세팅 등 시스템 설정 컬렉션 — 변경 없음 (위와 같음)
    match /settings/{document} {
      allow read, write: if true;
    }

    // [통합 앱] 시험 시간표 + 응시현황표·자리배치표 공용 데이터
    // 일반 교사는 로그인 없이 조회, 등록·수정·삭제는 관리자만
    match /timetable_config/{document} {
      allow read: if true;
      allow write: if isExamAdmin();
    }

    // [통합 앱] 시험 현황 자동화 데이터 (기존 elective-70356 프로젝트에서 이전)
    // 학생 선택과목 정보가 있으므로 관리자만 읽기·쓰기
    match /school_data/{document} {
      allow read, write: if isExamAdmin();
    }
  }
}
